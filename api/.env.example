# Copy to .env for local work. Never commit the real one.

DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/atlas_dev
RESEND_API_KEY=

# The single origin the API will accept, and the host the emailed links point
# at. Unset in production, where the constant in server.js is the only value.
SITE_ORIGIN=http://localhost:8788

# Set to `log` to collect emails in memory instead of sending them. The test
# suite sets this itself; it is here for working on the sign-up flow by hand.
MAIL_TRANSPORT=log

# The test suite, and only the test suite, reads this. It is the `Postgres-6dNn`
# Railway service, which has no public URL, so it is reached through a tunnel
# left running in another terminal:
#
#     railway connect Postgres-6dNn --tunnel-only -P 5433
#
# The database must be named atlas_test and the host must be loopback, or
# test/helpers.js refuses to run — the suite truncates every table it finds and
# the production instance is one typo away.
TEST_DATABASE_URL=postgres://postgres:password@127.0.0.1:5433/atlas_test
