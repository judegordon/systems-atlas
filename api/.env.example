# Copy to .env for local work. Never commit the real one.

DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/atlas_dev
RESEND_API_KEY=

# The single origin the API will accept, and the host the emailed links point
# at. Unset in production, where the constant in server.js is the only value.
SITE_ORIGIN=http://localhost:8788

# Set to `log` to collect emails in memory instead of sending them. The test
# suite sets this itself; it is here for working on the sign-up flow by hand.
MAIL_TRANSPORT=log

# The test suite, and only the test suite, reads this. It is `atlas_test` on the
# `Postgres-6dNn` Railway service, over its public TCP proxy —
# `railway variables --service Postgres-6dNn` has the host, port and password.
#
# A tunnel also works and is still accepted:
#
#     railway connect Postgres-6dNn --tunnel-only -P 5433
#
# The database must be named atlas_test or test/helpers.js refuses to run: the
# suite truncates every table it finds and the production instance is one typo
# away. Production's hostnames are refused by name as well.
TEST_DATABASE_URL=postgres://postgres:password@HOST.proxy.rlwy.net:PORT/atlas_test
